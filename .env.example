# Wix — chave de API de administrador, escopada ao site + permissão "Wix Data".
# NUNCA prefixar com NEXT_PUBLIC_. Gerar em manage.wix.com/account/api-keys.
WIX_ADMIN_API_KEY=

# URL pública do site — usada para montar links enviados por e-mail
# (ex: recuperação de senha). NUNCA derivar isso de headers de requisição
# (Host / X-Forwarded-Host podem ser forjados por quem chama a Server Action).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
